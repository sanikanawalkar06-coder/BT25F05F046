
#include <iostream>
using namespace std;

void quickSort(int arr[], int s, int e) {
    if (s >= e)
        return;

    int pivot = arr[e];
    int i = s - 1;

    for (int j = s; j < e; j++) {
        if (arr[j] < pivot) {
            i++;
            swap(arr[i], arr[j]);
        }
    }

    swap(arr[i + 1], arr[e]);
    int p = i + 1;

    quickSort(arr, s, p - 1);
    quickSort(arr, p + 1, e);
}

int main() {
    int n;

    cout << "Enter the number of elements: ";
    cin >> n;

    int arr[n];

    cout << "Enter " << n << " elements: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    quickSort(arr, 0, n - 1);

    cout << "Sorted array: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
